#!/usr/bin/env python3
"""Which VM is each e2e-failure-investigator run on right now.

Usage: e2e-vms [--all] [--list]
  --all   also show the last finished jobs
  --list  print the table only, no VM picker
Picking a VM copies the transcript-tail command to the clipboard and opens RDP to it in Windows App.
VM login: VM_USER / VM_PASSWORD in .env next to this script (see .env.example).
Needs `uip` signed in to the staging profile (`uip login --profile staging`).
"""
import base64, json, os, re, shutil, subprocess, sys, tempfile, urllib.request
from concurrent.futures import ThreadPoolExecutor

FOLDER, PROFILE = "e2e-investigator", "staging"


def uip(*args):
    out = subprocess.run(["uip", "or", "jobs", *args, "--folder-path", FOLDER, "--profile", PROFILE,
                          "--output", "json"], capture_output=True, text=True).stdout
    data = json.loads(out[out.find("{"):])
    if data.get("Result") != "Success":
        sys.exit(f"uip: {data.get('Message')} {data.get('Instructions', '')}")
    return data["Data"]


def vm_addresses():
    """HostMachineName -> (alias, public IP), from the cloud-robot pool behind each session's machine."""
    out = subprocess.run(["uip", "login", "refresh", "--profile", PROFILE, "--output", "json"],
                         capture_output=True, text=True).stdout
    auth = json.loads(out[out.find("{"):])
    auth = auth.get("Data", auth)
    base = f"{auth['BaseUrl'].rstrip('/')}/{auth['OrganizationName']}/{auth['TenantName']}/orchestrator_/odata"
    out = subprocess.run(["uip", "or", "sessions", "unattended", "list", "--folder-path", FOLDER, "--profile", PROFILE,
                          "--output", "json"], capture_output=True, text=True).stdout
    templates = {x["MachineId"] for x in json.loads(out[out.find("{"):]).get("Data", [])}
    vms = {}
    for t in templates:
        # Cloudflare answers Python's default User-Agent with 403 "error code: 1010".
        req = urllib.request.Request(f"{base}/CloudTemplates({t})/UiPath.Server.Configuration.OData.Machines?$top=100",
                                     headers={"Authorization": "Bearer " + auth["AccessToken"], "User-Agent": "e2e-vms/1.0"})
        try:
            machines = json.load(urllib.request.urlopen(req))["value"]
        except Exception as e:  # not a cloud-robot pool, or no access: names only
            print(f"note: no addresses for machine {t}: {e}", file=sys.stderr)
            continue
        for m in machines:
            vms[m["HostMachineName"]] = (m.get("Alias") or "-", m.get("IpAddress") or "-")
    return vms


def describe(job):
    """runId from the bootstrap script (only `jobs get` returns it), phase from the flow's element token."""
    args = uip("get", job["Key"]).get("InputArguments") or ""
    run = re.search(r"[a-z0-9-]+-\d{8}-\d{6}-[a-z0-9]{4}", args)
    fps = base64.b64decode((job.get("FpsContext") or "") + "==").decode("utf8", "ignore")
    phase = re.search(r"BpmnGenericWorkflow/(\w+)", fps)
    # A probe-phase.sh job is started by hand, so it has no flow element.
    return (run.group(0) if run else "?"), (phase.group(1) if phase else "probe")


def main():
    states = ["Running", "Pending"] + (["Successful", "Faulted"] if "--all" in sys.argv else [])
    jobs = [j for s in states
            for j in uip("list", "--state", s, "--process-name", "vm-exec-vm", "--all-fields", "--limit", "20")]
    if not jobs:
        print("no investigator jobs running or pending")
        return
    jobs.sort(key=lambda j: j.get("StartTime") or "9")
    with ThreadPoolExecutor(8) as pool:  # one `uip jobs get` per job; sequential took ~30s
        vms = pool.submit(vm_addresses)
        described = list(pool.map(describe, jobs))
        vms = vms.result()
    rows = [("VM", "ALIAS", "IP", "STATE", "STARTED", "PHASE", "RUN", "JOB")]
    for j, (run, phase) in zip(jobs, described):
        host = j.get("HostMachineName") or "-"
        rows.append((host, *vms.get(host, ("-", "-")), j["State"], (j.get("StartTime") or "")[11:16] or "-",
                     phase, run, j["Key"][:8]))
    w = [max(len(r[i]) for r in rows) for i in range(len(rows[0]))]
    for r in rows:
        print("  ".join(c.ljust(w[i]) for i, c in enumerate(r)).rstrip())
    if "--list" not in sys.argv and sys.stdin.isatty():
        pick(rows[1:])


# PowerShell for the VM: follow the newest Claude transcript of $run, text and tool calls only.
TAIL = r"""$f = Get-ChildItem "C:\vm-agent\notes\$run\claude-*.jsonl" | Sort-Object LastWriteTime | Select-Object -Last 1
Get-Content -Wait -Tail 200 $f.FullName | % {
  try { $e = $_ | ConvertFrom-Json } catch { return }
  if ($e.type -eq 'assistant') { foreach ($c in $e.message.content) {
    if ($c.type -eq 'text') { "TEXT: $($c.text)" }
    elseif ($c.type -eq 'tool_use') { "TOOL: $($c.name) $($c.input | ConvertTo-Json -Compress)" } } } }"""


def pick(rows):
    """Choose a VM (its latest run), copy the tail command, open RDP."""
    latest = {r[0]: r for r in rows if r[0] != "-" and r[6] != "?"}  # rows are oldest first
    if not latest:
        return
    lines = [f"{r[1]}  {r[3]:<10} {r[5]:<12} {r[6]}" for r in latest.values()]
    if shutil.which("fzf"):
        out = subprocess.run(["fzf", "--height=~10", "--reverse", "--prompt=VM> "],
                             input="\n".join(lines), capture_output=True, text=True).stdout.strip()
        if not out:
            return
        r = list(latest.values())[lines.index(out)]
    else:
        print()
        for i, line in enumerate(lines):
            print(f"  {i + 1}) {line}")
        choice = input("VM number (enter to skip): ").strip()
        if not choice.isdigit() or not 0 < int(choice) <= len(lines):
            return
        r = list(latest.values())[int(choice) - 1]
    tail = f"$run = '{r[6]}'\n{TAIL}\n"
    if r[2] == "-":
        copy(tail)
        print(f"\nNo IP for {r[1]}, so no RDP. Copied the tail command for {r[6]}.")
        return
    env = load_env()
    # Windows App opens .rdp files; clipboard redirection lets the paste reach the VM.
    rdp = os.path.join(tempfile.gettempdir(), f"e2e-vms-{r[1]}.rdp")
    with open(rdp, "w") as f:
        f.write(f"full address:s:{r[2]}\nredirectclipboard:i:1\n")
        if env.get("VM_USER"):
            f.write(f"username:s:{env['VM_USER']}\n")
    if env.get("VM_PASSWORD"):  # .rdp files can't hold a password on macOS: paste it at the prompt
        copy(env["VM_PASSWORD"])
    subprocess.run(["open", "-a", "Windows App", rdp])  # the .rdp default handler may be another app
    print(f"\nOpening RDP to {r[1]} ({r[2]}).")
    if env.get("VM_PASSWORD"):
        input("Password copied: paste it into Windows App, then press Enter here to copy the tail command.")
    copy(tail)
    print(f"Copied the tail command for {r[6]}. Paste it into PowerShell on {r[1]}.")


def copy(text):
    subprocess.run(["pbcopy"], input=text, text=True)


def load_env():
    """VM_USER / VM_PASSWORD from the gitignored .env next to this script."""
    path = os.path.join(os.path.dirname(os.path.realpath(__file__)), ".env")
    if not os.path.exists(path):
        return {}
    with open(path) as f:
        pairs = (line.split("=", 1) for line in f if "=" in line and not line.lstrip().startswith("#"))
        return {k.strip(): v.strip().strip("'\"") for k, v in pairs}

if __name__ == "__main__":
    main()
