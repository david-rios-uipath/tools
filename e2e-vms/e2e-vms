#!/usr/bin/env python3
"""Which VM is each e2e-failure-investigator run on right now.

Usage: e2e-vms [--all]   (--all also shows the last finished jobs)
Needs `uip` signed in to the staging profile (`uip login --profile staging`).
"""
import base64, json, re, subprocess, sys, urllib.request

FOLDER, PROFILE = "e2e-investigator", "staging"


def uip(*args):
    out = subprocess.run(["uip", "or", "jobs", *args, "--folder-path", FOLDER, "--profile", PROFILE,
                          "--output", "json"], capture_output=True, text=True).stdout
    data = json.loads(out[out.find("{"):])
    if data.get("Result") != "Success":
        sys.exit(f"uip: {data.get('Message')} {data.get('Instructions', '')}")
    return data["Data"]


def vm_addresses():
    """HostMachineName -> (alias, public IP), from the cloud-robot pool behind each session's machine."""
    out = subprocess.run(["uip", "login", "refresh", "--profile", PROFILE, "--output", "json"],
                         capture_output=True, text=True).stdout
    auth = json.loads(out[out.find("{"):])
    auth = auth.get("Data", auth)
    base = f"{auth['BaseUrl'].rstrip('/')}/{auth['OrganizationName']}/{auth['TenantName']}/orchestrator_/odata"
    out = subprocess.run(["uip", "or", "sessions", "unattended", "list", "--folder-path", FOLDER, "--profile", PROFILE,
                          "--output", "json"], capture_output=True, text=True).stdout
    templates = {x["MachineId"] for x in json.loads(out[out.find("{"):]).get("Data", [])}
    vms = {}
    for t in templates:
        # Cloudflare answers Python's default User-Agent with 403 "error code: 1010".
        req = urllib.request.Request(f"{base}/CloudTemplates({t})/UiPath.Server.Configuration.OData.Machines?$top=100",
                                     headers={"Authorization": "Bearer " + auth["AccessToken"], "User-Agent": "e2e-vms/1.0"})
        try:
            machines = json.load(urllib.request.urlopen(req))["value"]
        except Exception as e:  # not a cloud-robot pool, or no access: names only
            print(f"note: no addresses for machine {t}: {e}", file=sys.stderr)
            continue
        for m in machines:
            vms[m["HostMachineName"]] = (m.get("Alias") or "-", m.get("IpAddress") or "-")
    return vms


def describe(job):
    """runId from the bootstrap script (only `jobs get` returns it), phase from the flow's element token."""
    args = uip("get", job["Key"]).get("InputArguments") or ""
    run = re.search(r"[a-z0-9-]+-\d{8}-\d{6}-[a-z0-9]{4}", args)
    fps = base64.b64decode((job.get("FpsContext") or "") + "==").decode("utf8", "ignore")
    phase = re.search(r"BpmnGenericWorkflow/(\w+)", fps)
    # A probe-phase.sh job is started by hand, so it has no flow element.
    return (run.group(0) if run else "?"), (phase.group(1) if phase else "probe")


def main():
    states = ["Running", "Pending"] + (["Successful", "Faulted"] if "--all" in sys.argv else [])
    jobs = [j for s in states
            for j in uip("list", "--state", s, "--process-name", "vm-exec-vm", "--all-fields", "--limit", "20")]
    if not jobs:
        print("no investigator jobs running or pending")
        return
    vms = vm_addresses()
    rows = [("VM", "ALIAS", "IP", "STATE", "STARTED", "PHASE", "RUN", "JOB")]
    for j in sorted(jobs, key=lambda j: j.get("StartTime") or "9"):
        run, phase = describe(j)
        host = j.get("HostMachineName") or "-"
        rows.append((host, *vms.get(host, ("-", "-")), j["State"], (j.get("StartTime") or "")[11:16] or "-",
                     phase, run, j["Key"][:8]))
    w = [max(len(r[i]) for r in rows) for i in range(len(rows[0]))]
    for r in rows:
        print("  ".join(c.ljust(w[i]) for i, c in enumerate(r)).rstrip())
    print_tail_help(rows)


# PowerShell for the VM: follow the newest Claude transcript of $run, text and tool calls only.
TAIL = r"""$f = Get-ChildItem "C:\vm-agent\notes\$run\claude-*.jsonl" | Sort-Object LastWriteTime | Select-Object -Last 1
Get-Content -Wait -Tail 200 $f.FullName | % {
  try { $e = $_ | ConvertFrom-Json } catch { return }
  if ($e.type -eq 'assistant') { foreach ($c in $e.message.content) {
    if ($c.type -eq 'text') { "TEXT: $($c.text)" }
    elseif ($c.type -eq 'tool_use') { "TOOL: $($c.name) $($c.input | ConvertTo-Json -Compress)" } } } }"""


def print_tail_help(rows):
    runs = [r for r in rows[1:] if r[0] != "-" and r[6] != "?"]
    if not runs:
        return
    print("\nTo view agent output in a VM, RDP to its IP, open PowerShell, set $run:")
    for r in runs:
        print(f"  {r[1]} ({r[2]}):  $run = '{r[6]}'")
    print("then run (no transcript yet = the phase has not reached Claude, or never does: repro, pr, report):\n")
    print(TAIL)


if __name__ == "__main__":
    main()
